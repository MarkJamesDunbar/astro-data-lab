# Copy to .env. The database password lives in a separate file, never here.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=astro_lab
PGUSER=astro_lab
ASTRO_DB_PASSWORD_FILE=/absolute/path/to/postgres-password

# Where downloaded metadata, cleaned curves and checkpoints go.
ASTRO_DATA_DIR=/data/astro-data-lab
MAST_INVENTORY_DIR=/data/astro-data-lab/metadata/mast/spoc
CATALOGUE_SNAPSHOT_DIR=/data/astro-data-lab/metadata/catalogues
CURVE_CACHE_GIB=50          # cap on cached cleaned curves
FREE_SPACE_FLOOR_GIB=330    # never fill the disk below this
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENT_NAME=tess-classifiers
