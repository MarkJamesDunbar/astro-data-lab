# Copy to .env. The database password lives in a separate file, never here.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=astro_lab
PGUSER=astro_lab
ASTRO_DB_PASSWORD_FILE=/absolute/path/to/postgres-password

# Where metadata and cached light curves go.
ASTRO_DATA_DIR=/data/astro-data-lab                 # light curves are cached in ASTRO_DATA_DIR/lightcurves
MAST_INVENTORY_DIR=/data/astro-data-lab/metadata/mast/spoc
CATALOGUE_SNAPSHOT_DIR=/data/astro-data-lab/metadata/catalogues
LIGHTCURVE_CACHE_GIB=50     # least recently used curves are deleted above this
FREE_SPACE_FLOOR_GIB=330    # never download if the disk would drop below this

MLFLOW_TRACKING_URI=http://127.0.0.1:5000
